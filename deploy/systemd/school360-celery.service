# /etc/systemd/system/school360-celery.service  - SMS, SchoolPay sync, imports
[Unit]
Description=School360 Celery worker (default queue)
After=network.target redis-server.service postgresql.service

[Service]
User=school360
Group=www-data
WorkingDirectory=/srv/school360/app
EnvironmentFile=/srv/school360/app/.env
ExecStart=/srv/school360/venv/bin/celery -A school360 worker -Q default -l info \
    --concurrency=2 --hostname=default@%%h
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
